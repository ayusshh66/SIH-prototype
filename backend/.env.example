# Server Port (Railway automatically sets PORT)
PORT=5002

# Allowed CORS Origin(s) - set to your Vercel frontend deployment URL, or comma-separated list, or *
# e.g. https://your-project.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# Optional Database URL (PostgreSQL / Neon). If unset, defaults to authoritative in-memory seed dataset.
DATABASE_URL=

# Python Executable / Binary (defaults to python3 if unset)
PYTHON_BIN=python3

# Project Root containing the ai/ package (auto-detected if unset)
PROJECT_ROOT=
