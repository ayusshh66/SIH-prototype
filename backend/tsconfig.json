{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@schema": ["./src/db/schema/index"],
      "@schema/*": ["./src/db/schema/*"],
      "@db": ["./src/db/index"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/db/seed.ts", "src/modules/planning/optimizer.ts"]
}
